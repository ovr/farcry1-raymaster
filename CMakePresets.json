{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "x86",
      "displayName": "Win32 (Far Cry 1.4, STLport)",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "Win32", "strategy": "set" },
      "binaryDir": "${sourceDir}/build/x86"
    },
    {
      "name": "x64",
      "displayName": "x64 (compile-only)",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "x64", "strategy": "set" },
      "binaryDir": "${sourceDir}/build/x64"
    }
  ],
  "buildPresets": [
    { "name": "x86-debug",          "configurePreset": "x86", "configuration": "Debug" },
    { "name": "x86-relwithdebinfo", "configurePreset": "x86", "configuration": "RelWithDebInfo" },
    { "name": "x86-release",        "configurePreset": "x86", "configuration": "Release" },
    { "name": "x64-debug",          "configurePreset": "x64", "configuration": "Debug" },
    { "name": "x64-relwithdebinfo", "configurePreset": "x64", "configuration": "RelWithDebInfo" },
    { "name": "x64-release",        "configurePreset": "x64", "configuration": "Release" }
  ]
}
