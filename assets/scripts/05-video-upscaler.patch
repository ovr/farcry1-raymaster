+
+-- Upscaler (Far Cry RayMaster): d3d12_Upscaler and d3d12_UpscaleVersion, the upscaler of
+-- XRenderD3D12's 3D scene: None, FSR (auto: the version AMD FSR picks for the graphics card),
+-- FSR 3.1 or FSR 4. The renderer reads them every frame, so Apply needs no restart. With another
+-- renderer (no d3d12_Upscaler) both lists are greyed out.
+UI.PageOptionsVideo.GUI.widget_RMUpscaler.user.Initialize = function()
+	local widget = UI.PageOptionsVideo.GUI.widget_RMUpscaler;
+	widget:Clear();
+	widget:AddItem( Localize( "None" ) );
+	widget:AddItem( "FSR (auto)" );
+	widget:AddItem( "FSR 3.1" );
+	widget:AddItem( "FSR 4" );
+
+	local upscaler = getglobal( "d3d12_Upscaler" );
+	local index = 1;
+	if( upscaler and strlower( upscaler ) == "fsr" ) then
+		local version = tonumber( getglobal( "d3d12_UpscaleVersion" ) );
+		if( version == 3 ) then
+			index = 3;
+		elseif( version == 4 ) then
+			index = 4;
+		else
+			index = 2;
+		end
+	end
+	widget:SelectIndex( index );
+	widget.user.shownIndex = index;
+
+	if( upscaler ) then
+		UI:EnableWidget( widget );
+	else
+		UI:DisableWidget( widget );
+	end
+	widget.user.UpdateMode();
+end
+
+UI.PageOptionsVideo.GUI.widget_RMUpscaler.user.DefInitialize = function()
+	UI.PageOptionsVideo.GUI.widget_RMUpscaler:SelectIndex( 1 );
+	UI.PageOptionsVideo.GUI.widget_RMUpscaler.user.UpdateMode();
+end
+
+UI.PageOptionsVideo.GUI.widget_RMUpscaler.user.UpdateAssignedGlobals = function()
+	local widget = UI.PageOptionsVideo.GUI.widget_RMUpscaler;
+	local index = widget:GetSelectionIndex();
+	-- unchanged: the console's setting stays as it is
+	if( not getglobal( "d3d12_Upscaler" ) or not index or index == widget.user.shownIndex ) then
+		return;
+	end
+	if( index == 1 ) then
+		setglobal( "d3d12_Upscaler", "none" );
+	else
+		local versions = { 0, 3, 4 };
+		setglobal( "d3d12_UpscaleVersion", versions[ index - 1 ] );
+		setglobal( "d3d12_Upscaler", "fsr" );
+	end
+	widget.user.shownIndex = index;
+end
+
+-- The mode's list is greyed out while the upscaler is None (and with another renderer).
+UI.PageOptionsVideo.GUI.widget_RMUpscaler.user.UpdateMode = function()
+	local index = UI.PageOptionsVideo.GUI.widget_RMUpscaler:GetSelectionIndex();
+	if( getglobal( "d3d12_UpscaleMode" ) and index and index > 1 ) then
+		UI:EnableWidget( UI.PageOptionsVideo.GUI.widget_RMUpscaleMode );
+	else
+		UI:DisableWidget( UI.PageOptionsVideo.GUI.widget_RMUpscaleMode );
+	end
+end
+
+
+
+-- The upscaler's mode (Far Cry RayMaster), d3d12_UpscaleMode: the size the 3D scene is rendered
+-- at, which the upscaler takes to the screen's: Native AA (the screen's own, anti-aliasing only),
+-- Quality (1/1.5 of it across), Balanced (1/1.7), Performance (1/2) or Ultra Performance (1/3).
+UI.PageOptionsVideo.GUI.widget_RMUpscaleMode.user.Initialize = function()
+	local widget = UI.PageOptionsVideo.GUI.widget_RMUpscaleMode;
+	widget:Clear();
+	widget:AddItem( "Native AA" );
+	widget:AddItem( "Quality" );
+	widget:AddItem( "Balanced" );
+	widget:AddItem( "Performance" );
+	widget:AddItem( "Ultra Performance" );
+
+	local mode = tonumber( getglobal( "d3d12_UpscaleMode" ) );
+	if( not mode or mode < 0 or mode > 4 ) then
+		mode = 0;
+	end
+	widget:SelectIndex( mode + 1 );
+	widget.user.shownIndex = mode + 1;
+	UI.PageOptionsVideo.GUI.widget_RMUpscaler.user.UpdateMode();
+end
+
+UI.PageOptionsVideo.GUI.widget_RMUpscaleMode.user.DefInitialize = function()
+	UI.PageOptionsVideo.GUI.widget_RMUpscaleMode:SelectIndex( 1 );
+end
+
+UI.PageOptionsVideo.GUI.widget_RMUpscaleMode.user.UpdateAssignedGlobals = function()
+	local widget = UI.PageOptionsVideo.GUI.widget_RMUpscaleMode;
+	local index = widget:GetSelectionIndex();
+	-- unchanged: the console's setting stays as it is
+	if( not getglobal( "d3d12_UpscaleMode" ) or not index or index == widget.user.shownIndex ) then
+		return;
+	end
+	setglobal( "d3d12_UpscaleMode", index - 1 );
+	widget.user.shownIndex = index;
 end
 
 
