+--------------------------------------------------------
+-- Field of view (Far Cry RayMaster). The scripts set the field of view for a 4:3 screen, and the
+-- engine shows fov * height / width of it up and down, so a screen wider than 4:3 used to see less
+-- above and below. The console variable cl_fov is the field of view across the screen in degrees;
+-- 0, its default, keeps the view up and down of a 4:3 screen at any width (Hor+). Zooming and the
+-- vehicles change the field of view in the same proportion as before.
+Game:CreateVariable("cl_fov", "0", 256);	-- VF_DUMPTODISK: kept in system.cfg
+
+-- The field of view the engine gets for one the scripts set.
+function ZoomView:ScreenFov(fov)
+	local width = tonumber(r_Width) or 4;
+	local height = tonumber(r_Height) or 3;
+	local aspect = width / height;
+	local across = tonumber(cl_fov) or 0;
+	if (across > 0) then
+		if (across > 170) then
+			across = 170;
+		end
+		-- 90 degrees of the scripts show cl_fov across the screen
+		local up = 2 * atan(tan(across * 3.1415926 / 360) / aspect);
+		return fov * up * aspect / (3.1415926 / 2);
+	elseif (aspect > 4 / 3) then
+		return fov * aspect * 3 / 4;
+	end
+	return fov;
+end
+
+if (not Game.SetCameraFov4x3) then
+	Game.SetCameraFov4x3 = Game.SetCameraFov;
+	function Game:SetCameraFov(fov)
+		ZoomView.CameraFov = fov;
+		self:SetCameraFov4x3(ZoomView:ScreenFov(fov));
+	end
+end
+
+-- Called by ClientStuff every frame: gives the camera its field of view again when it has another
+-- one, as a player's camera has 90 degrees when the player spawns, or after cl_fov or the screen
+-- size has changed.
+function ZoomView:UpdateFov()
+	local fov = Game:GetCameraFov();
+	local screenfov = self:ScreenFov(self.CameraFov or self.NoZoom);
+	if (fov and abs(fov - screenfov) > 0.001) then
+		Game:SetCameraFov4x3(screenfov);
+	end
+end
