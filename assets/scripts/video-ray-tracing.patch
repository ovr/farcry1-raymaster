+-- Ray traced reflections (Far Cry RayMaster): d3d12_RTReflections, the water's reflection by rays
+-- of XRenderD3D12, which shows what the screen does not (the far side of a pier, the palms behind
+-- the camera): None, Rays (in place of the screen space reflection) or Hybrid (the screen space
+-- reflection where it finds the scene, the rays elsewhere). The renderer reads it every frame, so
+-- it needs no restart, and the presets of the page leave it as it is. With another renderer or a
+-- graphics card without DXR 1.1 (no d3d12_RTReflections) the list is greyed out.
+UI.PageOptionsVideoAdv.GUI.widget_RMRT.user.Initialize = function()
+	local widget = UI.PageOptionsVideoAdv.GUI.widget_RMRT;
+	widget:Clear();
+	widget:AddItem( Localize( "None" ) );
+	widget:AddItem( "Rays" );
+	widget:AddItem( "Hybrid" );
+
+	local rays = tonumber( getglobal( "d3d12_RTReflections" ) );
+	local index = 1;
+	if( rays and rays >= 1 ) then
+		index = min( rays, 2 ) + 1;
+	end
+	widget:SelectIndex( index );
+	widget.user.shownIndex = index;
+
+	if( rays ) then
+		UI:EnableWidget( widget );
+	else
+		UI:DisableWidget( widget );
+	end
+end
+
+UI.PageOptionsVideoAdv.GUI.widget_RMRT.user.UpdateAssignedGlobals = function()
+	local widget = UI.PageOptionsVideoAdv.GUI.widget_RMRT;
+	local index = widget:GetSelectionIndex();
+	-- unchanged: the console's setting stays as it is
+	if( not getglobal( "d3d12_RTReflections" ) or index == widget.user.shownIndex ) then
+		return;
+	end
+	UI.PageOptionsVideoAdv.user:SetGlobal( "d3d12_RTReflections", index - 1 );
+	if( UI.PageOptionsVideoAdv.user.setglobalTestOnly == 0 ) then
+		widget.user.shownIndex = index;
+	end
 end
 
 -- helper function for auto detect
