+-- Ambient occlusion (Far Cry RayMaster): d3d12_AO, XRenderD3D12's screen space ambient occlusion,
+-- which darkens corners, creases and the ground under and between objects: None, GTAO (Intel
+-- XeGTAO) or CACAO (AMD FidelityFX CACAO). The renderer reads it every frame, so it needs no
+-- restart, and the presets of the page leave it as it is. With another renderer (no d3d12_AO) the
+-- list is greyed out.
+UI.PageOptionsVideoAdv.GUI.widget_RMAO.user.Initialize = function()
+	local widget = UI.PageOptionsVideoAdv.GUI.widget_RMAO;
+	widget:Clear();
+	widget:AddItem( Localize( "None" ) );
+	widget:AddItem( "GTAO" );
+	widget:AddItem( "CACAO" );
+
+	local ao = getglobal( "d3d12_AO" );
+	local index = 1;
+	if( ao ) then
+		ao = strlower( ao );
+		if( ao == "gtao" or ao == "xegtao" ) then
+			index = 2;
+		elseif( ao == "cacao" ) then
+			index = 3;
+		end
+	end
+	widget:SelectIndex( index );
+	widget.user.shownIndex = index;
+
+	if( ao ) then
+		UI:EnableWidget( widget );
+	else
+		UI:DisableWidget( widget );
+	end
+end
+
+UI.PageOptionsVideoAdv.GUI.widget_RMAO.user.UpdateAssignedGlobals = function()
+	local widget = UI.PageOptionsVideoAdv.GUI.widget_RMAO;
+	local index = widget:GetSelectionIndex();
+	-- unchanged: the console's setting stays as it is
+	if( not getglobal( "d3d12_AO" ) or index == widget.user.shownIndex ) then
+		return;
+	end
+	local names = { "none", "gtao", "cacao" };
+	UI.PageOptionsVideoAdv.user:SetGlobal( "d3d12_AO", names[ index ] );
+	if( UI.PageOptionsVideoAdv.user.setglobalTestOnly == 0 ) then
+		widget.user.shownIndex = index;
+	end
+end
+
