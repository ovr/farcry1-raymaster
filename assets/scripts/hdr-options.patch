 -- and create screen from table
 UI:CreateScreenFromTable( "VideoAdvOptions", UI.PageOptionsVideoAdv.GUI );
 
+-- HDR (Far Cry RayMaster): the list sets r_HDRRendering and, while it is on, d3d12_ToneMap, the
+-- tone map of XRenderD3D12's HDR pipeline: None (no HDR), Soft (the soft shoulder: the game's
+-- picture, with what is brighter than white rolled off smoothly), ACES, AgX. The renderer reads
+-- them every frame, so they need no restart, and the presets of the page leave them as they are.
+-- With another renderer (no d3d12_ToneMap) the list is greyed out.
+UI.PageOptionsVideoAdv.GUI.widget_RMHdr.user.Initialize = function()
+	local widget = UI.PageOptionsVideoAdv.GUI.widget_RMHdr;
+	widget:Clear();
+	widget:AddItem( Localize( "None" ) );
+	widget:AddItem( "Soft" );
+	widget:AddItem( "ACES" );
+	widget:AddItem( "AgX" );
+
+	local hdr = tonumber( getglobal( "r_HDRRendering" ) ) or 0;
+	local tonemap = tonumber( getglobal( "d3d12_ToneMap" ) );
+	local index = 1;
+	if( hdr ~= 0 and tonemap ) then
+		-- tone maps 1 to 3; 0 (a clamp, set from the console) is shown as the soft shoulder
+		index = tonemap + 1;
+		if( index < 2 or index > 4 ) then
+			index = 2;
+		end
+	end
+	widget:SelectIndex( index );
+	widget.user.shownIndex = index;
+
+	if( tonemap ) then
+		UI:EnableWidget( widget );
+	else
+		UI:DisableWidget( widget );
+	end
+end
+
+UI.PageOptionsVideoAdv.GUI.widget_RMHdr.user.UpdateAssignedGlobals = function()
+	local widget = UI.PageOptionsVideoAdv.GUI.widget_RMHdr;
+	local index = widget:GetSelectionIndex();
+	-- unchanged: the console's settings stay as they are
+	if( not getglobal( "d3d12_ToneMap" ) or index == widget.user.shownIndex ) then
+		return;
+	end
+	if( index == 1 ) then
+		UI.PageOptionsVideoAdv.user:SetGlobal( "r_HDRRendering", 0 );
+	else
+		UI.PageOptionsVideoAdv.user:SetGlobal( "r_HDRRendering", 1 );
+		UI.PageOptionsVideoAdv.user:SetGlobal( "d3d12_ToneMap", index - 1 );
+	end
+	if( UI.PageOptionsVideoAdv.user.setglobalTestOnly == 0 ) then
+		widget.user.shownIndex = index;
+	end
+end
+
+-- HDR output (Far Cry RayMaster): d3d12_HDROutput, XRenderD3D12's output to a display in HDR mode
+-- (Windows: Use HDR): SDR, HDR10 or scRGB. The highlights of the scene (the sun, fire, lamps) go up
+-- to the display's peak, the rest of the picture, the HUD and the menu stay at the brightness of
+-- SDR content. It needs the HDR pipeline: choosing HDR10 or scRGB while HDR is None sets HDR to
+-- Soft. Applied without a restart; on a display in SDR the output stays SDR. With another renderer
+-- (no d3d12_HDROutput) the list is greyed out.
+UI.PageOptionsVideoAdv.GUI.widget_RMHdrOutput.user.Initialize = function()
+	local widget = UI.PageOptionsVideoAdv.GUI.widget_RMHdrOutput;
+	widget:Clear();
+	widget:AddItem( "SDR" );
+	widget:AddItem( "HDR10" );
+	widget:AddItem( "scRGB" );
+
+	local output = tonumber( getglobal( "d3d12_HDROutput" ) );
+	local index = 1;
+	if( output and output >= 1 and output <= 2 ) then
+		index = output + 1;
+	end
+	-- before SelectIndex: the selection made here is no choice of the player's (OnChanged)
+	widget.user.shownIndex = index;
+	widget:SelectIndex( index );
+
+	if( output ) then
+		UI:EnableWidget( widget );
+	else
+		UI:DisableWidget( widget );
+	end
+end
+
+UI.PageOptionsVideoAdv.GUI.widget_RMHdrOutput.user.OnChanged = function()
+	local widget = UI.PageOptionsVideoAdv.GUI.widget_RMHdrOutput;
+	local hdr = UI.PageOptionsVideoAdv.GUI.widget_RMHdr;
+	local index = widget:GetSelectionIndex();
+	if( index ~= 1 and index ~= widget.user.shownIndex and hdr:GetSelectionIndex() == 1 and getglobal( "d3d12_ToneMap" ) ) then
+		hdr:SelectIndex( 2 );
+	end
+end
+
+UI.PageOptionsVideoAdv.GUI.widget_RMHdrOutput.user.UpdateAssignedGlobals = function()
+	local widget = UI.PageOptionsVideoAdv.GUI.widget_RMHdrOutput;
+	local index = widget:GetSelectionIndex();
+	if( not getglobal( "d3d12_HDROutput" ) or index == widget.user.shownIndex ) then
+		return;
+	end
+	UI.PageOptionsVideoAdv.user:SetGlobal( "d3d12_HDROutput", index - 1 );
+	if( UI.PageOptionsVideoAdv.user.setglobalTestOnly == 0 ) then
+		widget.user.shownIndex = index;
+	end
+end
+
